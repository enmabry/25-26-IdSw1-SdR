@startuml
title Consultar Solicitud de Dispensa (Perspectiva RUP Final)

skinparam {
    StateBackgroundColor white
    StateBorderColor black
    NoteBackgroundColor lightyellow
    NoteBorderColor black
    ArrowColor green
    linetype ortho
}

hide empty description

state "DISPENSAS_ABIERTO" as startState <<sdlreceive>>
state "DISPENSAS_ABIERTO" as endState <<sdlreceive>>

[*] -[#green]-> startState

startState -[#green]-> SOLICITUD_DISPENSA_ABIERTA
note on link
    consultarSolicitudDispensa()
end note

state SOLICITUD_DISPENSA_ABIERTA {
    [*] -[#green]-> SeleccionarSolicitud
    
    state "Selección de Solicitud" as SeleccionarSolicitud <<sdlreceive>>
    note left of SeleccionarSolicitud
        Director de Grado <b>solicita</b> consultar
        una solicitud específica.
        Sistema <b>permite</b> el acceso al
        listado de solicitudes.
    end note
    
    SeleccionarSolicitud -[#green]-> VisualizarDetalle
    note on link
        seleccionarSolicitudDispensa()
    end note
    
    state "Visualización de Detalle" as VisualizarDetalle <<sdlreceive>>
    note right of VisualizarDetalle
        Director de Grado <b>solicita</b> ver el detalle.
        Sistema <b>permite</b> la visualización y
        <b>ejecuta</b> visualizarDetalleSolicitudDispensa().
        
        Muestra:
        • Datos del alumno
        • Asignatura solicitada
        • Motivos y documentación
        • Estado actual
        • Historial de cambios
    end note
    
    VisualizarDetalle -[#green]-> EditarSolicitud
    
    state "Edición de Solicitud" as EditarSolicitud <<sdlreceive>>
    note left of EditarSolicitud
        EDITAR:
        Director de Grado <b>solicita</b> editar.
        Sistema <b>permite</b> la edición.
        
        editarSolicitudDispensa()
    end note
    
    EditarSolicitud -[#green]-> VisualizarDetalle
    note on link
        guardarSolicitudDispensa()
    end note
    
    VisualizarDetalle -[#red]-> [*]
    note on link
        CERRAR:
        Director de Grado <b>solicita</b> salir.
        Sistema <b>permite</b> cerrar la consulta.
        
        cerrarConsultaSolicitudDispensa()
    end note
}

SOLICITUD_DISPENSA_ABIERTA -[#green]-> endState

endState -[#green]-> [*]

@enduml