@startuml
title Editar Solicitud de Dispensa

skinparam {
    StateBackgroundColor white
    StateBorderColor black
    NoteBackgroundColor lightyellow
    NoteBorderColor black
    ArrowColor green
    linetype ortho
}

state "SOLICITUD_DISPENSA_ABIERTA" as startState <<sdlreceive>>
state "SOLICITUD_DISPENSA_ABIERTA" as endState <<sdlreceive>>

DISPENSAS_ABIERTO -[#green]-> SOLICITUD_DISPENSA_ABIERTA
note on link
    consultarSolicitudDispensa()
end note

state SOLICITUD_DISPENSA_ABIERTA {
    [*] -[#green]-> VisualizacionSolicitud
    
    state "Revisión de Solicitud" as RevisarSolicitud <<sdlreceive>>
    note left of RevisarSolicitud
        Director de Grado <b>solicita</b> editar solicitud.
        Sistema <b>permite</b> el acceso y retornar datos.
    end note
    
    VisualizacionSolicitud -[#green]-> EdicionSolicitud
    note on link
        editarSolicitudDispensa()
    end note
    
    state "Edición de Solicitud" as EdicionSolicitud
    note right of EdicionSolicitud
        Director de Grado <b>solicita</b> modificar:
        • Estado (Aprobar/Rechazar)
        • Observaciones o motivo
        • Otros campos editables
        Sistema <b>permite</b> la edición de campos.
    end note
}

SOLICITUD_DISPENSA_ABIERTA -[#green]-> DISPENSAS_ABIERTO_FINAL
note on link
    GUARDAR:
    Director de Grado <b>solicita</b> guardar cambios.
    Sistema <b>permite</b> confirmar modificación.
    
    guardarSolicitudDispensa()
end note

endState -[#green]-> [*]
@enduml
