@startuml
title Guardar solicitud de dispensa (Director de Grado)

skinparam linetype polyline

state SOLICITUD_DISPENSA_ABIERTA_INICIAL as "SOLICITUD_DISPENSA_ABIERTA"
state DISPENSAS_ABIERTO_FINAL            as "DISPENSAS_ABIERTO"

SOLICITUD_DISPENSA_ABIERTA_INICIAL -[#green]-> guardarSolicitud

state guardarSolicitud as "guardarSolicitud()" {

    state " " as ValidarDatos
    state " " as VerificarCambios
    state " " as ConfirmarOperacion
    state " " as PersistirCambios

    [*] -[#green]-> ValidarDatos
    note on link
      <b>Director de Grado</b> selecciona "Guardar solicitud"
      tras realizar cambios sobre la dispensa.
      
      <b>Sistema</b> valida que todos los campos
      obligatorios estén completos y en un formato correcto.
    end note

    ValidarDatos -[#green]-> VerificarCambios
    note on link
      <b>Sistema</b> comprueba si efectivamente
      se han realizado cambios respecto a la versión previa
      de la solicitud.
    end note

    VerificarCambios -[#green]-> ConfirmarOperacion
    note on link
      <b>Sistema</b> presenta un resumen de la operación.
      El Director puede:
      • confirmar el guardado, o
      • cancelar la operación.
    end note

    ConfirmarOperacion -[#green]-> PersistirCambios
    note on link
      <b>Si confirma el guardado:</b>
      el Sistema procede a persistir los cambios.
      
      <b>Si cancela:</b>
      se descarta el guardado y se pierden
      los cambios no confirmados.
    end note

    PersistirCambios -[#green]-> [*]
    note on link
      <b>Sistema</b> guarda los cambios en la base de datos,
      actualiza el registro de la solicitud
      y muestra un mensaje de confirmación.
    end note
}

guardarSolicitud -[#green]-> DISPENSAS_ABIERTO_FINAL

@enduml
