@startuml
title Cerrar solicitud de dispensa

skinparam linetype polyline

state SOLICITUD_DISPENSA_ABIERTA_INICIAL as "SOLICITUD_DISPENSA_ABIERTA"
state DISPENSAS_ABIERTO_FINAL            as "DISPENSAS_ABIERTO"

SOLICITUD_DISPENSA_ABIERTA_INICIAL -[#green]-> cerrarSolicitud

state cerrarSolicitud as "cerrarSolicitud()" {

    state " " as VerificarCambios
    state " " as ConfirmarCierre

    [*] -[#green]-> VerificarCambios
    note on link
      <b>Alumno / Director de Grado</b> selecciona
      la opción "Cerrar solicitud" desde el detalle
      de la dispensa.
    end note

    VerificarCambios -[#green]-> ConfirmarCierre
    note on link
      <b>Sistema</b> comprueba si existen cambios
      sin guardar en la solicitud.

      • Si hay cambios → muestra un mensaje
        de advertencia pidiendo confirmación.
      • Si no hay cambios → permite cerrar directamente.
    end note

    ConfirmarCierre -[#green]-> [*]
    note on link
      <b>Si confirma el cierre:</b>
      el sistema descarta los cambios no guardados
      (si los hubiera) y cierra la solicitud.

      <b>Si cancela:</b>
      permanece en SOLICITUD_DISPENSA_ABIERTA
      (no se ejecuta esta transición).
    end note
}

cerrarSolicitud -[#green]-> DISPENSAS_ABIERTO_FINAL

@enduml
