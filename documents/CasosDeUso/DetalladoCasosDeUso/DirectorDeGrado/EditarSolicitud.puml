@startuml
title Editar Solicitud

skinparam {
    NoteBackgroundColor #whiteSmoke
    ArrowColor #green
    NoteBorderColor #green
    linetype polyline
}

hide empty description

state startState as "SOLICITUD_DISPENSA_ABIERTA"
state endState as "DISPENSAS_ABIERTO"

startState --> EditarSolicitud
note on link
    <b>Director de Grado selecciona</b>
    la opción "Editar solicitud"
    sobre una solicitud pendiente.
end note

state EditarSolicitud {
    state RevisarSolicitud as " "
    state ModificarEstadoYDatos as " "
    state FinalizarOpciones <<choice>>

    [*] --> RevisarSolicitud
    note on link
        <b>Sistema muestra</b>
        los datos completos de la solicitud:
        * Alumno
        * Asignatura / actividad
        * Motivo de la dispensa
        * Documentación adjunta
        * Estado actual
    end note

    RevisarSolicitud --> ModificarEstadoYDatos
    note on link
        <b>Director modifica</b>
        * Estado (Aprobar/Rechazar)
        * Observaciones o motivo
        * Otros campos editables
    end note

    ModificarEstadoYDatos --> FinalizarOpciones
    note on link
        <b>Sistema valida los cambios</b>
        Director selecciona una opción:
        * Guardar cambios
        * Cancelar operación
    end note

    FinalizarOpciones -[#red]-> [*]
    note on link
        <b>Si selecciona Cancelar:</b>
        Se aborta la operación sin guardar
        y la solicitud permanece sin cambios.
    end note

    FinalizarOpciones --> GuardarCambios

    state GuardarCambios as " "
    note on link
        <b>Sistema actualiza</b>
        el estado y datos de la solicitud,
        registra fecha y responsable,
        y notifica al alumno.
    end note

    GuardarCambios --> [*]
    note on link
        <b>Sistema confirma</b>
        que la solicitud ha sido actualizada.
    end note
}

EditarSolicitud --> endState

@enduml