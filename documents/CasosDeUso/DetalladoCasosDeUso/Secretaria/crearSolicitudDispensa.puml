@startuml
title Crear Solicitud de Dispensa 

skinparam linetype polyline

state startState as "DISPENSAS_ABIERTO"
state endState1 as "SOLICITUD_DISPENSA_ABIERTA" 
state endState2 as "DISPENSAS_ABIERTO" 

startState -[#green]-> crearSolicitudDispensa
note on link
    <b>Usuario selecciona</b>
    Crear Solicitud de Dispensa
end note

state crearSolicitudDispensa as "crearSolicitudDispensa()" {
    state SolicitudDatos as " "
    state ValidarDatos <<choice>>
    state CreacionExitosa as " "

    ' 1. Inicio: Presenta el formulario
    [*] -[#green]-> SolicitudDatos
    note on link
        <b>Sistema presenta formulario</b>
        para nueva solicitud.
    end note

    ' 2. Usuario introduce datos y se dispara la validación
    SolicitudDatos -[#green]-> ValidarDatos
    note on link
        <b>Usuario introduce datos</b>
        * Nombre/ID, Asignatura
        * Motivo, Documentos, Fechas
    end note

    ' --- FLUJO ALTERNATIVO (Error de validación - Rojo) ---
    ValidarDatos -[#red]-> SolicitudDatos
    note on link
        <b>Sistema valida si el alumno existe</b>
        y que los datos sean correctos.
        <b>Si hay error:</b>
        Sistema informa error y vuelve a solicitar.
    end note

    ' --- FLUJO BÁSICO (Éxito - Verde) ---
    ValidarDatos -[#green]-> CreacionExitosa
    
    note on link
        <b>Sistema valida y crea</b>
        la solicitud.
    end note
    
    CreacionExitosa -[#green]-> [*]
    note on link
        <b>Sistema confirma y muestra</b>
        la nueva solicitud registrada.
    end note
}

' Transiciones de Salida del Caso de Uso
crearSolicitudDispensa -[#green]-> endState1
note on link
    <b>editarSolicitudDispensa()</b>
end note

crearSolicitudDispensa -[#green]-> endState2
note on link
    <b>Guardar/Cerrar Solicitud()</b>
end note

@enduml