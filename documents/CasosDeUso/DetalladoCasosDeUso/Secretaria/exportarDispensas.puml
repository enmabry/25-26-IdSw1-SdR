@startuml
title Exportar Dispensas

skinparam linetype polyline

' Estados inicial y final globales basados en el Diagrama de Contexto
state startState as "DISPENSAS_ABIERTO"
state endState1 as "DISPENSAS_ABIERTO" 
state endState2 as "SOLICITUD_DISPENSA_ABIERTA"

startState -[#green]-> exportarDispensas
note on link
    <b>Usuario solicita</b>
    Exportar Dispensas
end note

state exportarDispensas as "exportarDispensas()" {
    state SolicitudFiltros as " "
    state ValidarFiltros <<choice>>
    state SolicitudFormato as " "
    state Descarga as " "

    ' 1. Inicio: Solicita los filtros
    [*] -[#green]-> SolicitudFiltros
    note on link
        <b>Sistema muestra opciones</b>
        de filtro y botón de exportación.
    end note

    ' 2. El usuario selecciona los filtros
    SolicitudFiltros -[#green]-> ValidarFiltros
    note on link
        <b>Usuario selecciona criterios:</b>
        * Curso, Asignatura, Nombre, Id
    end note

    ' --- 3. FLUJO ALTERNATIVO (Error de filtros - Camino Rojo) ---
    ValidarFiltros -[#red]-> SolicitudFiltros
    note on link
        <b>Sistema valida filtros.</b>
        <b>Si hay error:</b>
        Sistema informa error y vuelve a solicitar filtros.
    end note

    ' --- 4. FLUJO BÁSICO (Éxito - Verde) ---
    ValidarFiltros -[#green]-> SolicitudFormato
    
    note on link
        <b>Sistema solicita al usuario</b>
        el formato de salida (PDF, CSV, etc.) y nombre del archivo.
    end note
    
    SolicitudFormato -[#green]-> Descarga
    
    note on link
        <b>El usuario solicita la descarga.</b>
        Sistema permite la descarga.
    end note
    
    Descarga -[#green]-> [*]
    note on link
        <b>Sistema muestra confirmación</b>
        de la descarga.
    end note
}


exportarDispensas -[#green]-> endState1
note on link
    <b>Regreso a Dispensas Abierto</b>
end note

exportarDispensas -[#green]-> endState2
note on link
    <b>consultarSolicitudDispensa()</b>
end note

@enduml