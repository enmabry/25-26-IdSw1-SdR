@startuml
skinparam nodesep 60
skinparam ranksep 60
skinparam linetype polyline
skinparam NoteBackgroundColor lightyellow
skinparam NoteBorderColor gray
skinparam StateBackgroundColor #F5F5F5
skinparam StateBorderColor gray

state "importarAlumnos()" as importarAlumnos {
   
    state " " as Paso1
    state " " as Paso2
   
    [*] -[#green]-> Paso1
    note on link
      <b>Secretaría</b> solicita importar listado de alumnos
    end note
   
    Paso1 -[#green]-> Paso2
    note on link
      <b>Sistema</b> permite adjuntar un archivo de alumnos
    end note
   
    Paso2 -[#green]-> [*]
    note on link
      <b>Secretaría</b> adjunta el archivo
      <b>Sistema</b> procesa el archivo y muestra un informe de importación
      • Permite solicitar consultar detalle de alumno
      • Permite solicitar regresar al listado
    end note
}

state "ALUMNOS_ABIERTO" as ALUMNOS_ABIERTO
state "ALUMNO_DETALLE_ABIERTO" as ALUMNO_DETALLE_ABIERTO

importarAlumnos -[#green]---> ALUMNO_DETALLE_ABIERTO
note right on link
  consultarAlumno()
end note

importarAlumnos -[#blue]---> ALUMNOS_ABIERTO
note right on link
  regresar al listado
end note
@enduml
