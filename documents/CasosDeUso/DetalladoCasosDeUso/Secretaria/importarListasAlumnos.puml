@startuml
title Importar Listas Alumnos

skinparam linetype polyline

state startState as "LISTAS_ABIERTO"
state endState1 as "LISTA_ABIERTA"
state endState2 as "LISTAS_ABIERTO"

startState -[#green]-> exportarListadoAlumnosPorCurso
note on link
    <b>Usuario solicita</b>
    Exportar Importar Listo Alumnos
end note

state exportarListadoAlumnosPorCurso as "exportarListadoAlumnosPorCurso()" {
    state SolicitudFiltros as " "
    state ValidarFiltros <<choice>>
    state SeleccionFormato as " "
    state Descarga as " "
    
    ' 1. Inicio: Solicita los filtros
    [*] -[#green]-> SolicitudFiltros
    note on link
        <b>Sistema muestra opciones</b>
        de filtro y botón de exportación.
    end note

    ' 2. El usuario selecciona los filtros
    SolicitudFiltros -[#green]-> ValidarFiltros
    note on link
        <b>Usuario introduce criterios:</b>
        * Curso, Asignatura
    end note

    ' --- 3. FLUJO ALTERNATIVO (Error de filtros - Camino Rojo) ---
    ValidarFiltros -[#red]-> SolicitudFiltros
    note on link
        <b>Sistema valida filtros.</b>
        <b>Si hay error:</b>
        Sistema informa error y vuelve a solicitar filtros.
    end note

    ' --- 4. FLUJO BÁSICO (Éxito - Verde) ---
    ValidarFiltros -[#green]-> SeleccionFormato
    
    note on link
        <b>Sistema solicita al usuario</b>
        el formato de salida (PDF, CSV, etc.) y nombre.
    end note
    
    SeleccionFormato -[#green]-> Descarga
    
    note on link
        <b>El usuario solicita la descarga.</b>
        Sistema descarga.
    end note
    
    Descarga -[#green]-> [*]
    note on link
        <b>Sistema muestra confirmación.</b>
    end note
}


exportarListadoAlumnosPorCurso -[#green]-> endState1
note on link
    <b>ConsultarListaAlumnos()</b>
end note

exportarListadoAlumnosPorCurso -[#green]-> endState2


@enduml