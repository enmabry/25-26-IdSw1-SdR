@startuml
title Editar Solicitud Dispensa

skinparam linetype polyline

' Estados inicial y final globales basados en el Diagrama de Contexto
state startState as "SOLICITUD_DISPENSA_ABIERTA" 
state endState1 as "DISPENSA_ABIERTO" 
state endState2 as "SOLICITUD_DISPENSA_ABIERTA" 

startState -[#green]-> editarSolicitudDispensa
note on link
    <b>Usuario solicita</b>
    Editar Solicitud Dispensa
end note

state editarSolicitudDispensa as "editarSolicitudDispensa()" {
    state PermitirModificacion as " "
    state ValidarModificaciones <<choice>>

    ' 1. Inicio: Habilita la edición
    [*] -[#green]-> PermitirModificacion
    note on link
        <b>Sistema permite modificar</b>
        los datos de la solicitud.
    end note

    ' 2. El usuario realiza las modificaciones
    PermitirModificacion -[#green]-> ValidarModificaciones
    note on link
        <b>Usuario realiza las modificaciones</b>
        y el sistema valida en tiempo real.
    end note

    ' --- FLUJO ALTERNATIVO (Error de validación de datos - Camino Rojo) ---
    ValidarModificaciones -[#red]-> PermitirModificacion
    note on link
        <b>Sistema verifica la modificación</b>
        por tipo de dato .
        <b>Si hay error:</b>
        Sistema muestra error y permite corregir.
    end note

    ' --- 4. FLUJO BÁSICO (Éxito - Verde) ---
    ValidarModificaciones -[#green]-> [*]
    note on link
        <b>Sistema marca los datos</b>
        listos para ser guardados.
    end note
}

' --- TRANSICIONES DE SALIDA (Según tu dibujo) ---

editarSolicitudDispensa -[#green]-> endState1
note on link
    <b>Guardar/Cerrar Solicitud()</b>
end note

editarSolicitudDispensa -[#green]-> endState2
note on link
    <b>Mantiene la solicitud abierta</b>
    (Opción de transición sin acción en el link)
end note

@enduml