@startuml CerrarSolicitudDispensa
title Cerrar solicitud de dispensa
skinparam linetype polyline

state SOLICITUD_DISPENSA_ABIERTA_INICIAL as "SOLICITUD_DISPENSA_ABIERTA"
state DISPENSAS_ABIERTO_FINAL            as "DISPENSAS_ABIERTO"

SOLICITUD_DISPENSA_ABIERTA_INICIAL -[#green]-> cerrarSolicitud

state cerrarSolicitud as "cerrarSolicitud()" {

    state " " as Paso1

    [*] -[#green]-> Paso1
    note on link
    <b>Alumno</b> se encuentra en SOLICITUD_DISPENSA_ABIERTA,
    viendo el detalle de una solicitud de dispensa,
    y selecciona la opción "Cerrar solicitud".
    end note

    Paso1 -[#green]-> [*]
    note on link
    <b>Sistema</b> cierra la vista de detalle de la solicitud,
    descarta cualquier cambio no guardado
    y vuelve al listado de solicitudes del Alumno
    (DISPENSAS_ABIERTO) sin modificar el estado
    de la dispensa.
    end note
}

cerrarSolicitud -[#green]-> DISPENSAS_ABIERTO_FINAL
@enduml