@startuml
title Exportar Historial Asistencias

skinparam linetype polyline

state ASISTENCIAS_ABIERTO_INICIAL as "ASISTENCIAS_ABIERTO"
state ASISTENCIAS_ABIERTO_FINAL as "ASISTENCIAS_ABIERTO"

ASISTENCIAS_ABIERTO_INICIAL -[#green]-> exportarHistorialAsistencias

state exportarHistorialAsistencias as "exportarHistorialAsistencias()" {

    state " " as ConfiguracionExportacion
    state " " as GenerandoArchivo
    state " " as DescargaLista

    [*] -[#green]-> ConfiguracionExportacion
    note on link
    <b>Profesor</b> selecciona la opción de
    exportar historial
    end note

    ConfiguracionExportacion -[#green]-> GenerandoArchivo
    note on link
    <b>Sistema</b> solicita parámetros:
    • Rango de fechas
    • Formato (PDF / Excel)

    <b>Profesor</b> confirma la exportación
    end note

    GenerandoArchivo -[#green]-> DescargaLista
    note on link
    <b>Sistema</b> procesa la solicitud:
    • Recopila registros de asistencia
    • Calcula porcentajes de asistencia
    • Genera el documento físico
    end note

    DescargaLista -[#green]-> [*]
    note on link
    <b>Sistema</b> inicia la descarga del archivo
    end note

}

exportarHistorialAsistencias -[#green]-> ASISTENCIAS_ABIERTO_FINAL

@enduml
