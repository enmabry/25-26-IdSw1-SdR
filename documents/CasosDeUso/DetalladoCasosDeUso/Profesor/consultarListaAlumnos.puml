@startuml
title Consultar Lista Alumnos

skinparam linetype polyline

state LISTAS_ABIERTO_INICIAL as "LISTAS_ABIERTO"
state LISTA_ABIERTA_FINAL as "LISTA_ABIERTA"

LISTAS_ABIERTO_INICIAL -[#green]-> consultarListaAlumnos

state consultarListaAlumnos as "consultarListaAlumnos()" {

    state " " as SeleccionCurso
    state " " as RecuperandoDatos
    state " " as VistaDetallada

    [*] -[#green]-> SeleccionCurso
    note on link
    <b>Profesor</b> selecciona un curso o grado
    para ver el detalle de los alumnos
    end note

    SeleccionCurso -[#green]-> RecuperandoDatos
    note on link
    <b>Sistema</b> recibe el criterio de búsqueda
    
    <b>Sistema</b> consulta la base de datos para
    obtener los alumnos de ese curso específico
    end note

    RecuperandoDatos -[#green]-> VistaDetallada
    note on link
      <b>Sistema</b> muestra la tabla con los estudiantes
    listos para ser gestionados
    end note

    VistaDetallada -[#green]-> [*]

}

consultarListaAlumnos -[#green]-> LISTA_ABIERTA_FINAL

@enduml
