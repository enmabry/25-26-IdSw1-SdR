@startuml
left to right direction
skinparam packageStyle rectangle

actor DirectorDeGrado

rectangle "Sistema de Gestión Universitaria (CGU)" {

    package "Dispensas" {
        usecase "EditarSolicitud()" as DispensasEditarSolicitudes
        usecase "CerrarSolicitud()" as DispensasCerrarSolicitudes
        usecase "GuardarSolicitud()" as DispensasGuardarSolicitudes
        usecase "ConsultarSolicitudesDispensa()" as DispensasConsultarSolicitudes

    }

    DirectorDeGrado --> DispensasConsultarSolicitudes
    DirectorDeGrado --> DispensasEditarSolicitudes
    DirectorDeGrado --> DispensasCerrarSolicitudes
    DirectorDeGrado --> DispensasGuardarSolicitudes
}

@enduml