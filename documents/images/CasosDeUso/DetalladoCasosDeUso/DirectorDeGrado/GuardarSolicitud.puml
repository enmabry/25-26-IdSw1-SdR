@startuml
title Guardar Solicitud

skinparam {
    NoteBackgroundColor #whiteSmoke
    ArrowColor #green
    NoteBorderColor #green
    linetype polyline
}

hide empty description

state startState as "SOLICITUD_DISPENSA_ABIERTA"
state endState as "DISPENSAS_ABIERTO"

startState --> GuardarSolicitud
note on link
    <b>Director de Grado selecciona</b>
    la opción "Guardar solicitud"
    tras realizar cambios.
end note

state GuardarSolicitud {
    state ValidarDatos as " "
    state VerificarCambios as " "
    state FinalizarOpciones <<choice>>

    [*] --> ValidarDatos
    note on link
        <b>Sistema valida</b>
        que todos los campos obligatorios
        estén completos y sean correctos.
    end note

    ValidarDatos --> VerificarCambios
    note on link
        <b>Sistema verifica</b>
        que se hayan realizado cambios
        respecto al estado anterior.
    end note

    VerificarCambios --> FinalizarOpciones
    note on link
        <b>Director confirma</b>
        la operación de guardado:
        * Confirmar guardado
        * Cancelar operación
    end note

    FinalizarOpciones -[#red]-> [*]
    note on link
        <b>Si selecciona Cancelar:</b>
        Se descarta el guardado
        y se pierden los cambios no guardados.
    end note

    FinalizarOpciones --> PersistirCambios

    state PersistirCambios as " "
    note on link
        <b>Sistema persiste</b>
        todos los cambios realizados
        en la base de datos,
        actualiza usuario.
    end note

    PersistirCambios --> [*]
    note on link
        <b>Sistema confirma</b>
        que la solicitud ha sido guardada
        correctamente.
    end note
}

GuardarSolicitud --> endState

@enduml